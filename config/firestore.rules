rules_version = '2';

/* ===========================================================================
   Reglas de seguridad de CIVIZO Cocina

   Publicar: consola de Firebase → Firestore Database → Reglas → pegar este
   archivo → Publicar.  (o: firebase deploy --only firestore:rules)

   Roles
     owner     Dueño: todo. Lo obtiene la PRIMERA cuenta que se registra.
     admin     Todo, incluidas cuentas y ajustes (no puede tocar al dueño).
     editor    Lee y modifica insumos, recetas, servicios y eventos.
     consulta  Solo lee.
   Las cuentas nuevas nacen como "consulta" sin acceso (activo = false)
   hasta que un dueño o administrador las aprueba.
   =========================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function perfil() { return get(rutaPerfil()).data; }
    function conAcceso() { return request.auth != null && exists(rutaPerfil()) && perfil().activo == true; }
    function rol() { return perfil().rol; }
    function esOwner() { return conAcceso() && rol() == 'owner'; }
    function esAdmin() { return conAcceso() && rol() in ['owner', 'admin']; }
    function puedeEditar() { return conAcceso() && rol() in ['owner', 'admin', 'editor']; }
    function rutaArranque() { return /databases/$(database)/documents/sistema/arranque; }

    match /usuarios/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esAdmin();

      // Solicitud propia (sin acceso) o arranque del dueño en el mismo commit.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.correo == request.auth.token.email
        && (
          (request.resource.data.rol == 'consulta' && request.resource.data.activo == false)
          || (request.resource.data.rol == 'owner' && request.resource.data.activo == true
              && !exists(rutaArranque()) && existsAfter(rutaArranque()))
        );

      // El propio usuario solo actualiza su último acceso y su nombre.
      allow update: if (request.auth != null && request.auth.uid == uid && conAcceso()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso', 'nombre']))
        // Admin: cualquier cuenta que no sea dueño, y sin nombrar dueños.
        || (esAdmin() && resource.data.rol != 'owner' && request.resource.data.rol != 'owner')
        // Dueño: cualquier cuenta menos quitarse a sí mismo.
        || (esOwner() && request.auth.uid != uid);

      allow delete: if (esAdmin() && resource.data.rol != 'owner' && request.auth.uid != uid) || (esOwner() && request.auth.uid != uid);
    }

    match /sistema/arranque {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(rutaArranque())
        && request.resource.data.uid == request.auth.uid
        && getAfter(rutaPerfil()).data.rol == 'owner';
      allow update, delete: if false;
    }

    match /sistema/config {
      allow read: if conAcceso();
      allow write: if esAdmin();
    }

    // Sitio web público: cualquiera lee; solo administradores publican.
    match /sitio/publico {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /sitio_fotos/{slot} {
      allow read: if true;
      allow create, update: if esAdmin() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if esAdmin();
    }

    // Solicitudes de cotización: el público solo puede crear una solicitud
    // nueva con campos y tamaños acotados. Leer y dar seguimiento es del equipo.
    function texto(c, max) { return request.resource.data.get(c, '') is string && request.resource.data.get(c, '').size() <= max; }
    match /solicitudes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'empresa', 'telefono', 'correo', 'servicio', 'fecha', 'personas', 'mensaje', 'estatus', 'creado', 'actualizado', 'origen'])
        && request.resource.data.estatus == 'nueva'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 120
        && texto('telefono', 40) && texto('correo', 160) && texto('empresa', 160) && texto('servicio', 60)
        && texto('fecha', 10) && texto('mensaje', 2000) && texto('creado', 40) && texto('actualizado', 40) && texto('origen', 40)
        && request.resource.data.get('personas', 0) is int && request.resource.data.get('personas', 0) >= 0 && request.resource.data.get('personas', 0) <= 100000;
    }

    match /{col}/{id} {
      allow read: if conAcceso() && col in ['insumos', 'recetas', 'servicios', 'eventos', 'borrados', 'solicitudes'];
      allow write: if puedeEditar() && col in ['insumos', 'recetas', 'servicios', 'eventos', 'borrados', 'solicitudes'];
    }
  }
}
